    </div>

    <text class="week">{{ weekName }}</text>

    <div class="table">
      <div class="head">
        <text class="index-cell">序号</text>
        <text class="course-head">课程</text>
        <text class="delete-head">删除</text>
      </div>

      <div class="line" show="{{ r1 }}">
        <text class="index-cell">1</text>
        <input class="course-cell" type="button" value="{{ c1 }}" onclick="edit1" />
        <input class="delete-cell" type="button" value="删" onclick="delete1" />
      </div>
      <div class="line" show="{{ r2 }}">
        <text class="index-cell">2</text>
        <input class="course-cell" type="button" value="{{ c2 }}" onclick="edit2" />
        <input class="delete-cell" type="button" value="删" onclick="delete2" />
      </div>
      <div class="line" show="{{ r3 }}">
        <text class="index-cell">3</text>
        <input class="course-cell" type="button" value="{{ c3 }}" onclick="edit3" />
        <input class="delete-cell" type="button" value="删" onclick="delete3" />
      </div>
      <div class="line" show="{{ r4 }}">
        <text class="index-cell">4</text>
        <input class="course-cell" type="button" value="{{ c4 }}" onclick="edit4" />
        <input class="delete-cell" type="button" value="删" onclick="delete4" />
      </div>
      <div class="line" show="{{ r5 }}">
