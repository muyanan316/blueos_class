        <input class="course-cell" type="button" value="{{ c10 }}" onclick="edit10" />
        <input class="delete-cell" type="button" value="删" onclick="delete10" />
      </div>
      <div class="line" show="{{ r11 }}">
        <text class="index-cell">11</text>
        <input class="course-cell" type="button" value="{{ c11 }}" onclick="edit11" />
        <input class="delete-cell" type="button" value="删" onclick="delete11" />
      </div>
      <div class="line" show="{{ r12 }}">
        <text class="index-cell">12</text>
        <input class="course-cell" type="button" value="{{ c12 }}" onclick="edit12" />
        <input class="delete-cell" type="button" value="删" onclick="delete12" />
      </div>
      <div class="line" show="{{ r13 }}">
        <text class="index-cell">13</text>
        <input class="course-cell" type="button" value="{{ c13 }}" onclick="edit13" />
        <input class="delete-cell" type="button" value="删" onclick="delete13" />
      </div>
      <div class="line" show="{{ r14 }}">
        <text class="index-cell">14</text>
        <input class="course-cell" type="button" value="{{ c14 }}" onclick="edit14" />
        <input class="delete-cell" type="button" value="删" onclick="delete14" />
      </div>
      <div class="line" show="{{ r15 }}">
        <text class="index-cell">15</text>
        <input class="course-cell" type="button" value="{{ c15 }}" onclick="edit15" />
        <input class="delete-cell" type="button" value="删" onclick="delete15" />
      </div>

      <div class="add-line" show="{{ canAdd }}">
        <input class="add-btn" type="button" value="+" onclick="addCourse" />
